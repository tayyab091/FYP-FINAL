# Required
MONGODB_URI=mongodb://127.0.0.1:27017/test-fyp
JWT_SECRET=replace-with-a-long-random-secret

# Admin & seeding (development)
ADMIN_SETUP_KEY=your-secure-setup-key
ALLOW_DATABASE_SEEDING=true
ALLOW_ADMIN_SETUP=true

# Optional — AI & nutrition features degrade gracefully without these
GEMINI_API_KEY=
SPOONACULAR_API_KEY=

# Optional — Stripe payments (falls back to simulated checkout when unset or placeholder)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional alias used in email links (falls back to NEXT_PUBLIC_APP_URL)
APP_URL=http://localhost:3000

# Optional — transactional email (falls back to console.log links in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional — Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Realtime (Pusher) — required for live chat/notification push on Vercel
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# Live video (Daily.co) — required for Elite live training sessions
DAILY_API_KEY=

# Image uploads (Vercel Blob) — required for chat images on Vercel
BLOB_READ_WRITE_TOKEN=

# Runtime
NODE_ENV=development
