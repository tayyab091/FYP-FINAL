# Required
MONGODB_URI=mongodb://127.0.0.1:27017/test-fyp
JWT_SECRET=replace-with-a-long-random-secret

# Admin & seeding (development)
ADMIN_SETUP_KEY=your-secure-setup-key
ALLOW_DATABASE_SEEDING=true
ALLOW_ADMIN_SETUP=true

# Optional — AI & nutrition features degrade gracefully without these
GEMINI_API_KEY=
SPOONACULAR_API_KEY=

# Optional — Stripe (simulated payments are used in-app; real integration not wired)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Runtime
NODE_ENV=development
