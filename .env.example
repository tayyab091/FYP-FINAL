# Required
MONGODB_URI=mongodb://127.0.0.1:27017/test-fyp
JWT_SECRET=replace-with-a-long-random-secret

# Admin & seeding (development)
ADMIN_SETUP_KEY=your-secure-setup-key
ALLOW_DATABASE_SEEDING=true
ALLOW_ADMIN_SETUP=true

# Optional — AI & nutrition features degrade gracefully without these
GEMINI_API_KEY=
SPOONACULAR_API_KEY=

# Optional — Stripe payments (falls back to simulated checkout when unset or placeholder)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional alias used in email links (falls back to NEXT_PUBLIC_APP_URL)
APP_URL=http://localhost:3000

# Optional — transactional email (falls back to console.log links in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional — Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Realtime (Pusher) — required for live chat/notification push on Vercel
# Without these, chat/notifications still work via REST polling.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# Live video (Jitsi Meet) — no extra env vars required for meet.jit.si embeds
# If you later self-host Jitsi, add app-specific config in src/lib/jitsi.ts.

# Chat image uploads (Cloudinary) — required for image messages
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder; defaults to "chat"
CLOUDINARY_UPLOAD_FOLDER=chat

# Runtime
NODE_ENV=development

# Note (Windows): if MongoDB Atlas fails with querySrv ECONNREFUSED, the app
# resolves SRV via public DNS (see src/lib/mongodb.ts). Prefer Atlas or a local mongod.
